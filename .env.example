# Optional local credentials. Restart the server after changing this file.
# Never commit .env or publish it with dist.
ICONIK_AUTH_TOKEN=
ICONIK_APP_ID=
# Optional override; npm installs ffmpeg-static by default.
FFMPEG_PATH=

OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Hosted/private workspace runtime settings. Never put these in VITE_* variables.
# APP_ORIGIN is the exact public HTTPS origin, without a trailing slash.
APP_ORIGIN=
APP_PASSWORD=
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# Optional local extraction settings:
# MAX_MEDIA_BYTES=5368709120
# MEDIA_TEMP_DIR=
